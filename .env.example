# Copier ce fichier en .env et remplacer chaque valeur. Ne jamais commiter .env.
# Toutes les variables sont obligatoires : docker compose refuse de démarrer s'il en manque une.

# Sous Windows / Docker Desktop, 50000 convient
AIRFLOW_UID=50000

# Clés Airflow
# Fernet : docker run --rm apache/airflow:3.3.2 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=a_generer
# Une valeur différente pour chacune : docker run --rm apache/airflow:3.3.2 python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API__SECRET_KEY=a_generer
AIRFLOW__API_AUTH__JWT_SECRET=a_generer

# Compte administrateur de l'interface Airflow (créé au premier démarrage)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changer_moi

# Base interne d'Airflow (pris en compte uniquement à la création du volume)
POSTGRES_AIRFLOW_PASSWORD=changer_moi

# Base du projet qualite_donnees (pris en compte uniquement à la création du volume)
# Pas de caractères spéciaux (@ : / ?) : le mot de passe est inséré dans une URI de connexion
PROJET_DB_USER=projet
PROJET_DB_PASSWORD=changer_moi
